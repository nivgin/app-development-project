<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp"
    android:layout_marginTop="16dp">

    <!-- Amount EditText -->
    <EditText
        android:id="@+id/etAmount"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_edittext"
        android:hint="@string/hint_amount"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/etServing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etIngredient" />

    <!-- Serving Dropdown -->
    <Spinner
        android:id="@+id/etServing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnDelete"
        app:layout_constraintStart_toEndOf="@id/etAmount"
        app:layout_constraintTop_toBottomOf="@id/etIngredient" />

    <!-- Ingredient AutoCompleteTextView -->
    <com.google.android.material.textfield.MaterialAutoCompleteTextView
        android:id="@+id/etIngredient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_ingredient"
        android:inputType="text"
        android:padding="12dp"
        android:textSize="14sp"
        android:background="@drawable/bg_edittext"
        android:layout_marginEnd="8dp"
        android:completionThreshold="2"
        android:dropDownWidth="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnDelete"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/etAmount" />

    <!-- Delete Button -->
    <ImageButton
        android:id="@+id/btnDelete"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_trash"
        android:background="@drawable/bg_delete_button"
        app:tint="@color/white"
        android:padding="12dp"
        android:contentDescription="@string/delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
